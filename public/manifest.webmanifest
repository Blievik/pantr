{
  "name": "PantR",
  "short_name": "PantR",
  "description": "Track your food, scan grocery receipts, and use things up before they go bad.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F6F5",
  "theme_color": "#F4F6F5",
  "categories": ["food", "lifestyle", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Scan a receipt", "url": "/#scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Use it up", "url": "/#cook", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping list", "url": "/#list", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
