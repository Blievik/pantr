{
  // PantR: one Cloudflare Worker that serves the site and the API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantr",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only API calls run the Worker; everything else is served straight from /public.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Which Claude model reads receipts and writes recipes.
    // Haiku is cheapest. Switch to "claude-sonnet-5-5" if receipt reading isn't accurate enough.
    "MODEL": "claude-haiku-5-5"
  },
  // Per-IP limits. period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RECEIPT_LIMIT", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
    { "name": "RECIPE_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
